# Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/glitrai

# LLM provider (OpenAI-compatible). Get a free Groq API key at console.groq.com
LLM_API_KEY=YOUR-API-KEY
LLM_BASE_URL=LLM-URL
LLM_MODEL=llama-3.1-8b-instant

# Image provider: "mock" (default, no external calls) or "comfyui"
IMAGE_PROVIDER=mock
COMFYUI_BASE_URL=

# Absolute base URL of this service once deployed, e.g. https://glitrai-api.onrender.com
# Leave blank for local development (relative /static URLs work fine there).
PUBLIC_BASE_URL=
